{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "locations",
  "position": {
    "x": 24,
    "y": 84,
    "z": 3000,
    "width": 600,
    "height": 620,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_practice"
                    }
                  },
                  "Property": "practice_code"
                }
              },
              "queryRef": "dim_practice.practice_code",
              "nativeQueryRef": "practice_code"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Longitude"
                }
              },
              "queryRef": "_Measures.Longitude",
              "nativeQueryRef": "Longitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Latitude"
                }
              },
              "queryRef": "_Measures.Latitude",
              "nativeQueryRef": "Latitude"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Rate, last 12 months"
                }
              },
              "queryRef": "_Measures.Rate, last 12 months",
              "nativeQueryRef": "Rate, last 12 months",
              "displayName": "Rate"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "_Measures"
                            }
                          },
                          "Property": "Rate, last 12 months"
                        }
                      },
                      "FillRule": {
                        "linearGradient2": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#a9cdf6'"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#0b3a75'"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'asZero'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Practice locations (darker = higher rate)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "activeOnly",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_practice"
              }
            },
            "Property": "active"
          }
        },
        "type": "Advanced",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "dim_practice",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "active"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "true"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
