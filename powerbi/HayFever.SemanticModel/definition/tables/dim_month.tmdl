	column year
		dataType: int64
		formatString: 0
		lineageTag: 615535f6-eae7-5752-86c9-41b50cabeade
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column month
		dataType: int64
		formatString: 0
		lineageTag: 3bcda7b4-1691-5917-a29c-7d001f447b91
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		lineageTag: 3343f637-e6c4-5d31-b76e-5975bb2cbdaf
