		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = User

	column month_start
		dataType: dateTime
		isKey
		formatString: mmm yyyy
		lineageTag: 4efd4846-809b-5b74-9892-072118bf76cb
		summarizeBy: none
		sourceColumn: month_start

