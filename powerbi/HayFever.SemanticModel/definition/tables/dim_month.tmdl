	partition dim_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"year_month", Int64.Type}, {"month_start", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"peak_season", type logical}, {"period", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
